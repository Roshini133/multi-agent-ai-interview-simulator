# Copy to .env  (docker compose reads it automatically)
SECRET_KEY=replace-with-a-long-random-string       # python -c "import secrets; print(secrets.token_hex(32))"
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
DATABASE_URL=sqlite:////app/data/interview.db
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
# Optional heavy components (need INSTALL_OPTIONAL=true at build time)
INSTALL_OPTIONAL=false
EMBEDDINGS_ENABLED=false
WHISPER_ENABLED=false
WHISPER_MODEL=base.en
